        "crossover_prob": 0.9,
        "mutation_prob": 0.3,
        "n_swaps_per_mut": 2,
        "stagnation_limit": 20,
        "verbose": true
    },

    "use_snp_selection": true,
    "snp_selection_mode": "random",
    "num_snps": 20000,

    "seed": 14

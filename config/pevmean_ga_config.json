{
    "paths": {
        "npz": "Data/npz/snp_body_mass_ALL.npz",
        "output_dir": "outputs/pevmean_ga"
    },

    "traits": [
        {
            "name": "body_mass",
            "npz": "Data/npz/snp_body_mass_ALL.npz"
        }

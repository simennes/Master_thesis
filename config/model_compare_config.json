{
  "paths": {
    "npz": "Data/npz/snp_body_mass_ALL.npz",
    "pheno": "Data/pheno/adjusted_body_mass.csv"
  },

  "output": {
    "output_dir": "outputs/model_compare_final"
  },

  "target_islands": [9],
  "included_islands": null,

  "target_column": "y_adjusted",
  "eval_target_column": "y_mean",
  "standardize_features": true,
  "min_count": 20,

  "use_snp_selection": true,
  "snp_selection_mode": "random",
  "num_snps": 20000,

  "mlp": {
    "enabled": true,
    "use_early_stopping": false,
    "early_stopping_patience": 20,
    "restore_best": false,
    "train_params": {
      "hidden_dims": [512, 64],
      "dropout": 0.5,
      "batch_norm": false,
      "lr": 1e-5,
      "weight_decay": 1e-5,
      "epochs": 150,
      "batch_size": 64,
      "optimizer": "adam",
      "loss_name": "mse"
    }
  },

  "ridge": {
    "enabled": true,
    "alpha_selection": "cv_source",
    "cv_strategy": "loio_source",
    "alphas": [1e5],
    "cv_folds": 5,
    "alpha_floor_high_dim": null,
    "suppress_solver_warnings": true,
    "log_alpha_search": true
  },

  "evaluation": {
    "n_repeats": 5,
    "seed_stride": 1000,
    "removal_fractions": [0.0, 0.25, 0.5, 0.75]
  },

  "logging": {
    "mlp_verbose_training": false,
    "log_every_fraction": 1
  },

  "device": "auto",
  "seed": 10
}

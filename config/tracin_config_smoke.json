{
    "paths": {
        "npz": "Data/npz/snp_body_mass_ALL.npz",
        "phenotype_csv": "Data/pheno/adjusted_body_mass.csv",
        "output_dir": "outputs/tracin_addition_smoke_inrun"
    },
    "target_islands": [0],
    "included_islands": null,
    "n_target_islands": null,
    "target_column": "y_adjusted",
    "eval_target_column": "y_mean",
    "cal_fractions": [0.2],
    "experiment_mode": "iterative_addition",
    "iterative_addition": {
        "initial_fraction": 0.1,
        "fraction_per_step": 0.2,
        "n_steps": 2,
        "n_random_seeds": 3
    },
    "train_params": {
        "hidden_dims": [256, 64],
        "dropout": 0.3,
        "batch_norm": false,
        "lr": 2e-5,
        "weight_decay": 1e-5,
        "epochs": 12,
        "loss_name": "mse",
        "optimizer": "sgd"
    },
    "retrain_epochs": 12,
    "tracin": {
        "n_checkpoints": 3,
        "mode": "lastlayer"
    },
    "scoring": {
        "method": "inrun_firstorder",
        "window": "all",
        "weight_mode": "improvement",
        "flip_sign": true
    },
    "batch_size": 32,
    "epoch_scaling": "none",
    "early_stopping_patience": 0,
    "seed": 10,
    "device": "auto",
    "use_snp_selection": true,
    "snp_selection_mode": "random",
    "num_snps": 20000,
    "save_loss_curves": false,
    "save_retrain_loss_curves": false,
    "use_early_stopping": false
}

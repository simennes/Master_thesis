{
    "paths": {
        "npz": "Data/npz/snp_body_mass_ALL.npz"
    },

    "target_island": 4,
    "included_islands": null,

    "target_column": "y_adjusted",
    "eval_target_column": "y_mean",
    "standardize_features": true,
    "min_count": 20,

    "cal_fraction": 0.2,
    "max_cal_fraction": null,
    "n_repeats": 10,

    "model": {
        "type": "ridge",
        "alpha": 100000
    },

    "tmc": {
        "n_permutations": 50,
        "eps_trunc": 0.005,
        "use_truncation": false,
        "min_prefix_islands": 3,
        "island_sampling_mode": "mean",
        "cap_per_island": null,
        "n_train_seeds_per_eval": 1,
        "cache_dir": "outputs/tmc_weighted_ridge_one_setting/cache"
    },

    "baselines": {
        "n_random_orders": 10
    },

    "use_snp_selection": true,
    "snp_selection_mode": "random",
    "num_snps": 20000,

    "weighting": {
        "methods": [
            {"name": "relu", "floor": 0.05},
            {"name": "softmax", "temperature": 0.5, "floor": 0.05},
            {"name": "minmax", "floor": 0.05},
            {"name": "rank", "mode": "inverse", "floor": 0.05},
            {"name": "shifted_relu", "quantile": 0.25, "floor": 0.05}
        ]
    },

    "output_dir": "outputs/tmc_weighted_ridge_one_setting",
    "device": "auto",
    "seed": 14
}
